#define WIFI_PASS      "TU_PASSWORD_WIFI"
#define API_HOST       "www.danysolutions.online"
#define API_PORT       443
#define API_PATH       "/api/gate/device/ws"
// openssl rand -hex 32  -> el MISMO valor que GATE_DEVICE_SECRET del backend (64 caracteres hex)
#define DEVICE_SECRET_HEX "PEGA_AQUI_64_HEX"
#define RELAY_PIN      26          // GPIO que maneja el relé
#define RELAY_ACTIVE_HIGH 1        // 1 si el módulo se activa con HIGH; 0 si es "active low"
#define MAX_HOLD_MS    30000       // tope absoluto por presión (debe ser >= GATE_MAX_HOLD_S del backend)
#define DEADMAN_MS     800         // sin heartbeat válido en este tiempo -> relé OFF
// CA raíz que firma el certificado de tu dominio (Let's Encrypt: ISRG Root X1).
// Descárgala de https://letsencrypt.org/certs/isrgrootx1.pem y pégala completa.
static const char CA_CERT[] PROGMEM = R"PEM(
-----BEGIN CERTIFICATE-----
...PEGA AQUI ISRG Root X1...
-----END CERTIFICATE-----
)PEM";
